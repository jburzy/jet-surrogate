! Hidden Valley emerging-jet signal: s-channel Z' -> qv qvbar, identical
! benchmark to displaced-observables (Schwaller-Stolarski-Weiler / Dark
! Showers Task Force unflavored scenario). Dark-pion lifetime
! (4900111:tau0), the dark-sector mass scale, the random seed and the event
! count are appended programmatically by scripts/generate.py.

Beams:idA = 2212
Beams:idB = 2212
Beams:eCM = 13600.

! ---- hard process: s-channel Zv ----
HiddenValley:ffbar2Zv = on
4900023:m0 = 1500.
4900023:mWidth = 15.
4900023:onMode = off
4900023:onIfAny = 4900101

! ---- dark sector: SU(3), one light flavor, running coupling ----
HiddenValley:Ngauge = 3
HiddenValley:alphaOrder = 1
HiddenValley:Lambda = 10.
HiddenValley:FSR = on
HiddenValley:fragment = on
HiddenValley:pTminFSR = 11.
HiddenValley:probVector = 0.75

! ---- dark sector masses (nominal benchmark, overridden per --mpid) ----
4900101:m0 = 10.     ! dark quark qv
4900111:m0 = 5.      ! dark pion pi_d
4900113:m0 = 20.     ! dark rho rho_d (rho -> pi pi open)

! ---- decays back to SM ----
4900113:oneChannel = 1 1.0 0 4900111 4900111
4900111:oneChannel = 1 1.0 91 1 -1
4900111:mayDecay = on

! ---- generic settings ----
Random:setSeed = on
Main:timesAllowErrors = 100
Init:showChangedSettings = off
Init:showChangedParticleData = off
Next:numberCount = 1000
Next:numberShowEvent = 0
Next:numberShowProcess = 0
Next:numberShowInfo = 0
